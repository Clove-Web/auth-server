{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["@cloudflare/workers-types"],

    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",

    // pixelarticons/react's own .d.ts types its components against real React
    // (SVGProps, React.JSX.Element). wrangler.jsonc aliases that package's
    // `react` import to `hono/jsx` at runtime, so this repo actually gets
    // hono/jsx elements back; this stub tells tsc that instead.
    "paths": {
      "pixelarticons/react": ["./src/types/pixelarticons-react.ts"]
    },

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src"]
}
